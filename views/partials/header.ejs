<header class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 mb-4 bg-white border rounded shadow-sm">
  <div class="d-flex align-items-center mb-3 mb-md-0">
    <div class="btn-whatsapp-teal d-flex align-items-center justify-content-center rounded me-3" style="width: 40px; height: 40px; font-weight: 700; font-size: 1.25rem;">
      W
    </div>
    <div>
      <h1 class="h5 mb-0 fw-bold">Waland API Wrapper</h1>
      <span class="text-muted small">WhatsApp M2M Business Console</span>
    </div>
  </div>

  <div>
    <ul class="nav nav-pills" id="dashboard-tabs" role="tablist">
      <% if (config.apiKey) { %>
        <li class="nav-item" role="presentation">
          <button class="nav-link active" onclick="switchTab('sessions')" type="button">
            <i class="fa-solid fa-server me-1"></i> Sessions
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" onclick="switchTab('send')" type="button">
            <i class="fa-solid fa-paper-plane me-1"></i> Send Message
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" onclick="switchTab('logs')" type="button">
            <i class="fa-solid fa-list-ul me-1"></i> Message Logs
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" onclick="switchTab('credentials')" type="button">
            <i class="fa-solid fa-key me-1"></i> Waland Setup
          </button>
        </li>
      <% } else { %>
        <li class="nav-item" role="presentation">
          <button class="nav-link active" onclick="switchTab('credentials')" type="button">
            <i class="fa-solid fa-key me-1"></i> Setup Required
          </button>
        </li>
      <% } %>
    </ul>
  </div>
</header>
