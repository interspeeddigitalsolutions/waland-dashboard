<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Waland M2M Dashboard</title>
  <!-- Bootstrap 5.3 CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <!-- Custom WhatsApp SVG Favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='32' fill='%23128c7e'/%3E%3Cpath d='M64 28C44.1 28 28 44.1 28 64c0 6.9 1.9 13.4 5.3 19L29 99l16.4-4.3c5.4 3 11.6 4.7 18.6 4.7 19.9 0 36-16.1 36-36.1 0-19.9-16.1-35.3-36-35.3zm0 6c16.6 0 30 13.4 30 30S80.6 94 64 94c-6 0-11.6-1.8-16.3-4.8l-9.8 2.6 2.6-9.5c-3.2-4.5-5-10.1-5-16.1 0-16.6 13.4-30 30-30z' fill='%23fff'/%3E%3C/svg%3E">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Custom WhatsApp Branding CSS -->
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>

  <div class="container py-4">
    <!-- Modular Header Partial -->
    <%- include('partials/header') %>

    <!-- Main Workspace Container -->
    <main>
      <% if (!config.apiKey) { %>
        <!-- Gated/Setup Required view: only Onboarding Wizard is shown -->
        <div id="pane-credentials" class="tab-pane">
          <%- include('partials/setup') %>
        </div>
      <% } else { %>
        <!-- Fully Configured Workspace -->
        
        <!-- Sessions Tab -->
        <div id="pane-sessions" class="tab-pane">
          <%- include('partials/sessions') %>
        </div>

        <!-- Send Message Tab -->
        <div id="pane-send" class="tab-pane d-none">
          <%- include('partials/send') %>
        </div>

        <!-- Message History Logs Tab -->
        <div id="pane-logs" class="tab-pane d-none">
          <%- include('partials/logs') %>
        </div>

        <!-- Credentials/Setup Tab -->
        <div id="pane-credentials" class="tab-pane d-none">
          <%- include('partials/setup') %>
        </div>
      <% } %>
    </main>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="toast-container"></div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  
  <!-- Consolidated Modular JavaScript -->
  <script src="/js/app.js"></script>

  <!-- Dynamic Server Initialization Scripts -->
  <script>
    window.addEventListener('load', () => {
      <% if (config.apiKey && sessions && sessions.length > 0) { %>
        <% sessions.forEach(session => { %>
          <% if (session.status === 'initializing' || session.status === 'authenticating' || session.status === 'qr_ready') { %>
            pollSessionStatus('<%= session.id %>');
            <% if (session.status === 'qr_ready') { %>
              // Automatically fetch QR code for any sessions waiting in qr_ready state
              viewQrCode('<%= session.id %>');
            <% } %>
          <% } %>
        <% }) %>
      <% } %>
    });
  </script>
</body>
</html>
